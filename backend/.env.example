# Server Configuration
PORT=5000

# Client Frontend URL for CORS (supports comma-separated list, or *)
# Local: http://localhost:5173
# Production (Vercel): https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/your_database_name
# MongoDB Atlas (Production):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/expense_tracker?retryWrites=true&w=majority

# JWT Secret Key
# Replace with a strong, random secret (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=development
